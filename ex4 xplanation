# 2. YACC file — `switch.y`

Here is the grammar.

```c
%{
#include <stdio.h>

int yylex();
void yyerror(const char *s);

int case_count = 0;
int default_count = 0;
%}

/* Tokens */

%token SWITCH
%token CASE DEFAULT

%token BREAK CONTINUE RETURN
%token IF ELSE
%token FOR WHILE DO

%token PRINTF SCANF

%token INT FLOAT CHAR DOUBLE

%token ID
%token INT_CONST FLOAT_CONST CHAR_CONST STRING

%token PLUS MINUS MUL DIV MOD
%token EQ NE LE GE LT GT
%token AND OR NOT
%token ASSIGN
%token ADD_ASSIGN SUB_ASSIGN MUL_ASSIGN DIV_ASSIGN MOD_ASSIGN
%token INC DEC

%token LPAREN RPAREN
%token LBRACE RBRACE
%token LBRACKET RBRACKET
%token COLON SEMICOLON COMMA

%token UNKNOWN

%%

/* Start symbol */

program:
        switch_statement
        {
            printf("\n-----------------------------\n");
            printf("Switch Analysis Completed\n");
            printf("-----------------------------\n");

            printf("Number of case labels    : %d\n", case_count);
            printf("Number of default labels : %d\n", default_count);
        }
        ;

/* Switch statement */

switch_statement:
        SWITCH LPAREN expression RPAREN
        LBRACE
        case_list
        RBRACE
        {
            printf("\nValid switch statement\n");
        }
        ;

/* List of cases */

case_list:
        case_list case_block
        |
        case_list default_block
        |
        case_block
        |
        default_block
        ;

/* Case block */

case_block:
        CASE constant COLON statement_list
        {
            case_count++;
            printf("Case label found\n");
        }
        ;

/* Default block */

default_block:
        DEFAULT COLON statement_list
        {
            default_count++;
            printf("Default label found\n");
        }
        ;

/* Statements */

statement_list:
        statement_list statement
        |
        statement
        ;

/* Different types of statements */

statement:
        expression_statement
        |
        BREAK SEMICOLON
        {
            printf("break statement found\n");
        }
        |
        CONTINUE SEMICOLON
        {
            printf("continue statement found\n");
        }
        |
        RETURN expression SEMICOLON
        {
            printf("return statement found\n");
        }
        |
        conditional_statement
        |
        loop_statement
        |
        function_call
        ;

/* Expression statement */

expression_statement:
        expression SEMICOLON
        ;

/* If-else */

conditional_statement:
        IF LPAREN expression RPAREN statement
        |
        IF LPAREN expression RPAREN statement ELSE statement
        ;

/* Loops */

loop_statement:
        WHILE LPAREN expression RPAREN statement
        |
        DO statement WHILE LPAREN expression RPAREN SEMICOLON
        |
        FOR LPAREN expression_statement
              expression_statement
              expression
        RPAREN statement
        ;

/* Function calls */

function_call:
        PRINTF LPAREN STRING RPAREN SEMICOLON
        |
        SCANF LPAREN STRING RPAREN SEMICOLON
        ;

/* Expressions */

expression:
        ID
        |
        INT_CONST
        |
        FLOAT_CONST
        |
        CHAR_CONST
        |
        expression PLUS expression
        |
        expression MINUS expression
        |
        expression MUL expression
        |
        expression DIV expression
        |
        expression MOD expression
        |
        expression EQ expression
        |
        expression NE expression
        |
        expression LT expression
        |
        expression GT expression
        |
        expression LE expression
        |
        expression GE expression
        |
        expression AND expression
        |
        expression OR expression
        |
        NOT expression
        |
        ID ASSIGN expression
        |
        LPAREN expression RPAREN
        ;

/* Constants allowed in case */

constant:
        INT_CONST
        |
        FLOAT_CONST
        |
        CHAR_CONST
        ;

%%

int main()
{
    printf("Enter the switch statement:\n\n");

    if (yyparse() == 0)
    {
        printf("\nParsing successful.\n");
    }
    else
    {
        printf("\nParsing failed.\n");
    }

    return 0;
}

void yyerror(const char *s)
{
    printf("\nSyntax Error: %s\n", s);
}
```

